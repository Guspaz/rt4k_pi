<script>
    async function handleAreaClick(param) {
        blinkImage();

        // No OSD refresh here: the server sees the device's own remote echo and pushes the
        // new frame over /OsdStream by itself.
        await fetch(`/RemoteCommand/${param.replace(/\s/g, "")}`, { method: 'POST' });
    }

    function blinkImage() {
        const image = document.getElementById('remoteLed');
        let count = 0;
        const maxBlinks = 6;
        const opacities = [1, 0.75];

        image.style.opacity = opacities[0];

        const interval = setInterval(() => {
            count++;
            image.style.opacity = opacities[count % 2];
            if (count >= maxBlinks) {
                clearInterval(interval);
                image.style.opacity = 0;
            }
        }, 50);
    }

    let oldFactor = @(Model.Settings.RemoteScale);

    // Natural width of the remote artwork; the height is taken from the image once it loads
    const remoteWidth = 830;

    // Width of the column between the remote and the OSD that holds the scale controls.
    // Must match the inline width on #scaleButtons, which centres them within it.
    const scaleColumnWidth = 130;

    async function handleScale(factor) {
        const remoteImage = document.getElementById('remote');
        const ledImage = document.getElementById('remoteLed');
        const buttonDiv = document.getElementById('scaleButtons');

        const width = remoteWidth * (factor / 100.0);

        remoteImage.style.width = width + "px";
        ledImage.style.width = width + "px";

        // The remote is absolutely positioned, so nothing else can infer its footprint
        buttonDiv.style.left = width + "px";
        document.getElementById('osdPanel').style.left = (width + scaleColumnWidth) + "px";
        resizeRemoteArea();

        imageMapResize();

        if (factor != oldFactor)
        {
            await fetch(`/UpdateSetting/RemoteScale/${factor}`, { method: 'POST' });
        }

        oldFactor = factor;
    }

    // Absolutely positioned children contribute no height, so reserve it explicitly or the
    // page's following content slides up underneath the remote.
    function resizeRemoteArea() {
        const remoteImage = document.getElementById('remote');

        if (remoteImage.naturalWidth) {
            const scaled = remoteImage.naturalHeight * (remoteImage.clientWidth / remoteImage.naturalWidth);
            document.getElementById('remoteArea').style.height = scaled + "px";
        }
    }

    document.getElementById('remote').addEventListener('load', resizeRemoteArea);

    handleScale(@Model.Settings.RemoteScale);

    // The server renders the OSD 1:1, so magnification is purely a client-side resize
    let osdFactor = @(Model.Settings.OsdScale);

    async function handleOsdScale(factor) {
        const previous = osdFactor;
        osdFactor = factor;
        applyOsdScale();

        if (factor != previous) {
            await fetch(`/UpdateSetting/OsdScale/${factor}`, { method: 'POST' });
        }
    }

    function applyOsdScale() {
        const image = document.getElementById('osdImage');

        if (image.naturalWidth) {
            image.style.width = (image.naturalWidth * (osdFactor / 100.0)) + "px";
        }
    }

    // The OSD is composed server-side and pushed to us, so there is nothing to poll, rate limit
    // or refresh after a keypress: the server watches the device's own remote echo and sends a
    // new frame the moment one exists.
    const scaler = document.getElementById('osdStatus').dataset.scaler;

    const osdMessages = {
        Disconnected: `Not connected to the ${scaler}.`,
        PoweredOff: `The ${scaler} is off.`,
        Blank: 'Nothing is on screen.',
        Error: 'OSD unavailable.',
        Unknown: `Waiting for the ${scaler}\u2026`
    };

    const osdStream = new EventSource('/OsdStream');

    osdStream.onmessage = (event) => {
        const frame = JSON.parse(event.data);
        const image = document.getElementById('osdImage');
        const status = document.getElementById('osdStatus');

        if (!frame.image) {
            image.style.display = 'none';
            status.textContent = osdMessages[frame.state] || osdMessages.Unknown;
            return;
        }

        image.onload = applyOsdScale;
        image.src = 'data:image/png;base64,' + frame.image;
        image.style.display = '';

        // A frame is still shown when the OSD goes away, just dimmed, so say why
        status.textContent = frame.state === 'Live' ? '' : (osdMessages[frame.state] || '');
    };

    osdStream.onerror = () => {
        // EventSource reconnects on its own; just say so while it's down
        document.getElementById('osdStatus').textContent = osdMessages.Error;
    };

    // Tells the server we're still here. Without this the mirror would keep polling the RT4K
    // long after the page was closed, because a navigated-away SSE socket still looks writable
    // to the server for tens of seconds.
    function sendOsdHeartbeat() {
        if (!document.hidden) {
            fetch('/OsdWatch', { method: 'POST', keepalive: true }).catch(() => { });
        }
    }

    sendOsdHeartbeat();
    const osdHeartbeat = setInterval(sendOsdHeartbeat, 2000);

    // Leaving the page: drop the stream and stop renewing so capture stops promptly
    window.addEventListener('pagehide', () => {
        clearInterval(osdHeartbeat);
        osdStream.close();
    });

</script>